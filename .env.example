# Copia este archivo como .env y llena lo que uses. .env NO se sube a GitHub.
# Todo es opcional: sin nada, Super Alexa usa avisos y llamadas simulados.

# Red de la casa: 0.0.0.0 para que la Raspberry, los ESP32 y otras pantallas
# lleguen al servidor. Sin esto, solo esta computadora.
LUMINA_HOST=127.0.0.1
# Clave que deben mandar la Raspberry y los ESP32 (X-Lumina-Token). Inventa una larga.
DEVICE_TOKEN=

# Alertas a n8n (workflow con webhook)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/superalexa-alert

# Número que recibe alertas y llamadas (formato internacional)
TWILIO_ALERT_PHONE=

# WhatsApp y llamadas reales con Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CALL_FROM=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Voz natural con ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
